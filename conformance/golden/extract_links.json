[
  {
    "id": "basic",
    "html": "<a href=\"/a\">A</a><a href=\"b\">B</a><a href=\"https://other.dev/c\">C</a>",
    "selector": "a",
    "baseUrl": "https://example.com/dir/page",
    "expected": [
      "https://example.com/a",
      "https://example.com/dir/b",
      "https://other.dev/c"
    ]
  },
  {
    "id": "entities",
    "html": "<a href=\"?a=1&amp;b=2\">x</a><a href=\"&#47;slash\">y</a><a href=\"/q?x=1&copy=2\">z</a><a href=\"/e?a&lt;b\">w</a>",
    "selector": "a",
    "baseUrl": "https://example.com/",
    "expected": [
      "https://example.com/?a=1&b=2",
      "https://example.com/slash",
      "https://example.com/q?x=1&copy=2",
      "https://example.com/e?a%3Cb"
    ]
  },
  {
